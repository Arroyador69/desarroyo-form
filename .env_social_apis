# 🌐 CONFIGURACIÓN DE APIS DE REDES SOCIALES
# Copia estas variables a tu archivo .env principal

# Base URL del servidor (para callbacks OAuth)
BASE_URL=http://localhost:3000

# === TIKTOK API ===
TIKTOK_CLIENT_ID=tu_tiktok_client_id_aqui
TIKTOK_CLIENT_SECRET=tu_tiktok_client_secret_aqui

# === YOUTUBE API (Google) ===
YOUTUBE_CLIENT_ID=tu_google_client_id_aqui
YOUTUBE_CLIENT_SECRET=tu_google_client_secret_aqui

# === INSTAGRAM API (Facebook/Meta) ===
INSTAGRAM_CLIENT_ID=tu_instagram_client_id_aqui
INSTAGRAM_CLIENT_SECRET=tu_instagram_client_secret_aqui

# === FACEBOOK API ===
FACEBOOK_CLIENT_ID=tu_facebook_client_id_aqui
FACEBOOK_CLIENT_SECRET=tu_facebook_client_secret_aqui

# 📋 INSTRUCCIONES PARA OBTENER LAS CREDENCIALES:

# 1. TIKTOK:
#    - Ve a: https://developers.tiktok.com/
#    - Crea una app
#    - Obtén Client ID y Client Secret
#    - Configura redirect URI: http://localhost:3000/api/social/platforms/tiktok/oauth/callback

# 2. YOUTUBE (Google):
#    - Ve a: https://console.cloud.google.com/
#    - Crea un proyecto y habilita YouTube Data API v3
#    - Crea credenciales OAuth 2.0
#    - Configura redirect URI: http://localhost:3000/api/social/platforms/youtube/oauth/callback

# 3. INSTAGRAM:
#    - Ve a: https://developers.facebook.com/
#    - Crea una app de Instagram Basic Display
#    - Obtén App ID y App Secret
#    - Configura redirect URI: http://localhost:3000/api/social/platforms/instagram/oauth/callback

# 4. FACEBOOK:
#    - Ve a: https://developers.facebook.com/
#    - Crea una app de Facebook
#    - Obtén App ID y App Secret
#    - Configura redirect URI: http://localhost:3000/api/social/platforms/facebook/oauth/callback

# ⚠️ IMPORTANTE:
# - Nunca compartas estas credenciales
# - Usa diferentes credenciales para desarrollo y producción
# - Mantén estos valores seguros en tu archivo .env 