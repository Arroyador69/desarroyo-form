{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.js",
      "use": "@vercel/static",
      "config": {
        "excludeFiles": ["server.js"]
      }
    }
  ],
  "functions": {
    "scripts/webhook_respuestas.py": {
      "runtime": "python3.11"
    }
  },
  "routes": [
    {
      "src": "/webhook/whatsapp",
      "dest": "/scripts/webhook_respuestas.py"
    },
    {
      "src": "/webhook/encuesta", 
      "dest": "/scripts/webhook_respuestas.py"
    },
    {
      "src": "/health",
      "dest": "/scripts/webhook_respuestas.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "TWILIO_ACCOUNT_SID": "@twilio_account_sid",
    "TWILIO_AUTH_TOKEN": "@twilio_auth_token", 
    "TWILIO_WHATSAPP_NUMBER": "@twilio_whatsapp_number",
    "DEEPSEEK_API_KEY": "@deepseek_api_key",
    "TELEGRAM_BOT_TOKEN": "@telegram_bot_token",
    "TELEGRAM_CHAT_ID": "@telegram_chat_id",
    "WEBSITE_URL": "https://desarroyo.tech",
    "BUSINESS_NAME": "DesArroyo Tech",
    "YOUR_NAME": "Alberto"
  }
} 