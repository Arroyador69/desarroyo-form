# 🔐 Variables de Entorno - DesArroyo.tech CRM
# Copia este archivo como .env y configura tus valores

# Configuración del servidor
PORT=3000
NODE_ENV=production

# Contraseña del administrador (cambiar por seguridad)
ADMIN_PASSWORD=admin123

# Secret para JWT tokens (cambiar por seguridad)
JWT_SECRET=desarroyo-secret-key-2024

# Secret para sesiones (cambiar por seguridad)
SESSION_SECRET=desarroyo-session-secret

# API Keys
DEEPSEEK_API_KEY=tu_api_key_deepseek
STRIPE_SECRET_KEY=tu_stripe_secret_key
STRIPE_PUBLIC_KEY=tu_stripe_public_key
STRIPE_WEBHOOK_SECRET=tu_stripe_webhook_secret

# Configuración de email
ZOHO_EMAIL=tu_email_zoho
ZOHO_PASSWORD=tu_password_zoho

# Configuración de Telegram
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token
TELEGRAM_CHAT_ID=tu_telegram_chat_id

# Configuración de base de datos
DATABASE_PATH=./dashboard.db

# Configuración de logs
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Configuración de seguridad
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=1800000
TOKEN_EXPIRATION=24h

# Configuración de CORS
ALLOWED_ORIGINS=https://desarroyo.tech,https://www.desarroyo.tech

# Configuración de backup
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION=30
BACKUP_PATH=./backups/

# Configuración para llamadas automáticas
TWILIO_ACCOUNT_SID=tu_twilio_account_sid
TWILIO_AUTH_TOKEN=tu_twilio_auth_token
TWILIO_PHONE_NUMBER=tu_twilio_phone_number
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Configuración Vonage (para números españoles)
VONAGE_API_KEY=tu_vonage_api_key
VONAGE_API_SECRET=tu_vonage_api_secret
VONAGE_PHONE_NUMBER=tu_vonage_phone_number

# Configuración del negocio
BUSINESS_NAME=DesArroyo Tech
WEBSITE_URL=https://desarroyo.tech

# IMPORTANTE: NUNCA usar nombres personales en llamadas automáticas
# Las llamadas dirán "Soy un agente comercial de DesArroyo Tech" 