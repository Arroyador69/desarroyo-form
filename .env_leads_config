# ===================================================
# CONFIGURACIÓN SISTEMA DE LEADS - DESARROYO TECH
# ===================================================

# 1. SCRAPING GRATUITO - Usando script Python propio
# NO NECESITA API KEY - COMPLETAMENTE GRATIS
# Solo necesita las librerías de Python instaladas

# 2. DEEPSEEK - Para generar mensajes personalizados con IA (MÁS BARATO)
# Regístrate en: https://platform.deepseek.com/
# Costo estimado: $3-8/mes (10x más barato que OpenAI)
DEEPSEEK_API_KEY=sk-tu_deepseek_key_aqui

# OPCIONAL: OpenAI como backup
# OPENAI_API_KEY=sk-tu_openai_key_aqui

# 3. TWILIO - Para enviar mensajes de WhatsApp
# Regístrate en: https://www.twilio.com/
# Configura WhatsApp Business API
TWILIO_ACCOUNT_SID=tu_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_auth_token_aqui
TWILIO_WHATSAPP_NUMBER=+1234567890

# 4. TELEGRAM - Para notificaciones del sistema
# Crea un bot con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# 5. TU SITIO WEB - URL base de tu sitio
WEBSITE_URL=https://desarroyo.tech

# ===================================================
# CONFIGURACIÓN PERSONALIZADA
# ===================================================

# Ciudades objetivo (separadas por coma)
TARGET_CITIES=Madrid,Barcelona,Valencia,Sevilla,Bilbao

# Sectores objetivo (separadas por coma)  
TARGET_SECTORS=restaurantes,peluquerias,dentistas,abogados,hoteles,gimnasios

# Tu nombre/marca para los mensajes
BUSINESS_NAME=DesArroyo Tech
YOUR_NAME=Alberto

# ===================================================
# WEBHOOKS (Se configuran en n8n después)
# ===================================================
WEBHOOK_RESPUESTA_CLIENTE=https://tu-n8n-url.com/webhook/respuesta-cliente
WEBHOOK_ENCUESTA_COMPLETADA=https://tu-n8n-url.com/webhook/encuesta-completada 